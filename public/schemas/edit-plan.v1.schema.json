{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videostitch.dev/schemas/edit-plan.v1.schema.json",
  "title": "VideoStitch Edit Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "baseRevisionId", "name", "createdAt", "provenance", "viewerGoal", "sourceCoordinateSystem", "uncertainties", "protectedBeats", "operations"],
  "properties": {
    "schemaVersion": { "const": "videostitch.edit-plan.v1" },
    "id": { "$ref": "#/$defs/id" },
    "baseRevisionId": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "createdAt": { "type": "string", "format": "date-time" },
    "provenance": { "type": "string", "minLength": 1, "maxLength": 240 },
    "viewerGoal": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "sourceCoordinateSystem": { "const": "source-milliseconds" },
    "uncertainties": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "protectedBeats": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "operations": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/operation" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "milliseconds": { "type": "integer", "minimum": 0 },
    "operationBase": {
      "type": "object",
      "required": ["id", "kind", "title", "detail", "rationale", "confidence", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "status": { "const": "proposed" }
      }
    },
    "operation": {
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "enum": ["trim-start", "trim-end"] }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "amountMs": { "type": "integer", "minimum": 1 } }, "required": ["amountMs"] }] },
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "const": "set-aspect" }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "ratio": { "enum": ["16:9", "9:16", "1:1"] } }, "required": ["ratio"] }] },
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "const": "trim-clip" }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "clipId": { "$ref": "#/$defs/id" }, "sourceInMs": { "$ref": "#/$defs/milliseconds" }, "sourceOutMs": { "$ref": "#/$defs/milliseconds" } }, "required": ["clipId", "sourceInMs", "sourceOutMs"] }] },
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "const": "split-clip" }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "clipId": { "$ref": "#/$defs/id" }, "sourceTimeMs": { "$ref": "#/$defs/milliseconds" } }, "required": ["clipId", "sourceTimeMs"] }] },
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "const": "remove-clip" }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "clipId": { "$ref": "#/$defs/id" } }, "required": ["clipId"] }] },
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "const": "reorder-clips" }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "clipIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }, "required": ["clipIds"] }] },
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "const": "set-clip-audio" }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "clipId": { "$ref": "#/$defs/id" }, "volume": { "type": "number", "minimum": 0, "maximum": 1 }, "muted": { "type": "boolean" }, "fadeInMs": { "$ref": "#/$defs/milliseconds" }, "fadeOutMs": { "$ref": "#/$defs/milliseconds" } }, "required": ["clipId", "volume", "muted", "fadeInMs", "fadeOutMs"] }] },
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "const": "add-text" }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "overlay": { "$ref": "#/$defs/textOverlay" } }, "required": ["overlay"] }] },
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "const": "set-clip-transform" }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "clipId": { "$ref": "#/$defs/id" }, "transform": { "$ref": "#/$defs/visualTransform" } }, "required": ["clipId", "transform"] }] },
        { "allOf": [{ "$ref": "#/$defs/operationBase" }, { "type": "object", "additionalProperties": false, "properties": { "id": true, "kind": { "const": "add-broll" }, "title": true, "detail": true, "rationale": true, "confidence": true, "status": true, "clip": { "$ref": "#/$defs/brollClipInput" } }, "required": ["clip"] }] }
      ]
    },
    "visualTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fit", "scale", "positionX", "positionY"],
      "properties": {
        "fit": { "enum": ["contain", "cover"] },
        "scale": { "type": "number", "minimum": 1, "maximum": 3 },
        "positionX": { "type": "number", "minimum": -100, "maximum": 100 },
        "positionY": { "type": "number", "minimum": -100, "maximum": 100 }
      }
    },
    "brollClipInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "name", "timelineStartMs", "sourceInMs", "sourceOutMs", "opacity", "visualFadeInMs", "visualFadeOutMs", "transform"],
      "properties": {
        "assetId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "timelineStartMs": { "$ref": "#/$defs/milliseconds" },
        "sourceInMs": { "$ref": "#/$defs/milliseconds" },
        "sourceOutMs": { "$ref": "#/$defs/milliseconds" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "visualFadeInMs": { "$ref": "#/$defs/milliseconds" },
        "visualFadeOutMs": { "$ref": "#/$defs/milliseconds" },
        "transform": { "$ref": "#/$defs/visualTransform" }
      }
    },
    "textOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "startMs", "endMs", "position", "fontSize", "color", "background"],
      "properties": {
        "kind": { "enum": ["caption", "title"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "startMs": { "$ref": "#/$defs/milliseconds" },
        "endMs": { "$ref": "#/$defs/milliseconds" },
        "position": { "enum": ["top", "center", "bottom"] },
        "fontSize": { "type": "integer", "minimum": 28, "maximum": 120 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "background": { "type": "boolean" }
      }
    }
  }
}
