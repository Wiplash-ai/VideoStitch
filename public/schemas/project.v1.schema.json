{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videostitch.dev/schemas/project.v1.schema.json",
  "title": "VideoStitch Project Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "editorialMode", "residency", "createdAt", "updatedAt", "canvas", "assets", "clips", "brollClips", "transcript", "overlays", "revisions", "currentRevisionId", "editPlans", "approvals"],
  "properties": {
    "schemaVersion": { "const": "videostitch.project.v1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "editorialMode": { "enum": ["podcast", "advertisement", "product-demo", "custom"] },
    "residency": { "const": "local" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "canvas": { "type": "object", "required": ["ratio", "width", "height"], "properties": { "ratio": { "enum": ["16:9", "9:16", "1:1"] }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
    "assets": { "type": "array", "items": { "type": "object", "required": ["id", "name", "mimeType", "size", "durationMs", "width", "height", "sha256", "importedAt"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "mimeType": { "type": "string" }, "size": { "type": "integer", "minimum": 0 }, "durationMs": { "type": "integer", "minimum": 0 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string" }, "importedAt": { "type": "string" } } } },
    "clips": { "type": "array", "items": { "type": "object", "required": ["id", "assetId", "name", "sourceInMs", "sourceOutMs", "color", "volume", "muted", "fadeInMs", "fadeOutMs", "visualFadeInMs", "visualFadeOutMs", "transform"], "properties": { "id": { "type": "string" }, "assetId": { "type": "string" }, "name": { "type": "string" }, "sourceInMs": { "type": "integer", "minimum": 0 }, "sourceOutMs": { "type": "integer", "minimum": 0 }, "color": { "enum": ["coral", "gold", "sage", "blue"] }, "volume": { "type": "number", "minimum": 0, "maximum": 1 }, "muted": { "type": "boolean" }, "fadeInMs": { "type": "integer", "minimum": 0 }, "fadeOutMs": { "type": "integer", "minimum": 0 }, "visualFadeInMs": { "type": "integer", "minimum": 0 }, "visualFadeOutMs": { "type": "integer", "minimum": 0 }, "transform": { "$ref": "#/$defs/visualTransform" } } } },
    "brollClips": { "type": "array", "items": { "type": "object", "required": ["id", "assetId", "name", "timelineStartMs", "sourceInMs", "sourceOutMs", "opacity", "visualFadeInMs", "visualFadeOutMs", "transform"], "properties": { "id": { "type": "string" }, "assetId": { "type": "string" }, "name": { "type": "string" }, "timelineStartMs": { "type": "integer", "minimum": 0 }, "sourceInMs": { "type": "integer", "minimum": 0 }, "sourceOutMs": { "type": "integer", "minimum": 0 }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "visualFadeInMs": { "type": "integer", "minimum": 0 }, "visualFadeOutMs": { "type": "integer", "minimum": 0 }, "transform": { "$ref": "#/$defs/visualTransform" } } } },
    "transcript": { "type": "array", "items": { "type": "object", "required": ["id", "startMs", "endMs", "text", "source"], "properties": { "id": { "type": "string" }, "startMs": { "type": "integer", "minimum": 0 }, "endMs": { "type": "integer", "minimum": 0 }, "text": { "type": "string", "minLength": 1 }, "speaker": { "type": "string" }, "source": { "const": "imported" } } } },
    "overlays": { "type": "array" },
    "revisions": { "type": "array", "minItems": 1 },
    "currentRevisionId": { "type": "string", "minLength": 1 },
    "editPlans": { "type": "array" },
    "approvals": { "type": "array" }
  },
  "$defs": {
    "visualTransform": {
      "type": "object",
      "required": ["fit", "scale", "positionX", "positionY"],
      "properties": {
        "fit": { "enum": ["contain", "cover"] },
        "scale": { "type": "number", "minimum": 1, "maximum": 3 },
        "positionX": { "type": "number", "minimum": -100, "maximum": 100 },
        "positionY": { "type": "number", "minimum": -100, "maximum": 100 }
      }
    }
  }
}
